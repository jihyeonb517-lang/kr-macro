    {"id": "internals", "name": "추세·수급",   "labels": {"pos": "강함", "neu": "보통", "neg": "약세"}},
    {"id": "sentiment", "name": "변동성·투자심리", "labels": {"pos": "안정", "neu": "중립", "neg": "불안"}},
